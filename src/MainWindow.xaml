<Window x:Class="CodexUsage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 额度监控" Width="190" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191C21"/><SolidColorBrush x:Key="TextBrush" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A7B0BD"/><SolidColorBrush x:Key="LineBrush" Color="#3A404B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#242830"/><SolidColorBrush x:Key="AccentBrush" Color="#7EE3BA"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,5,0,5"/></Style>
  </Window.Resources>
  <Border x:Name="Shell" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="17">
    <StackPanel>
      <Border x:Name="Handle" Background="Transparent" Padding="10,7" Cursor="Hand" ToolTip="点击查看详情 · 拖动移动 · 右键打开菜单"
              MouseLeftButtonDown="HandleDown" MouseMove="HandleMove" MouseLeftButtonUp="HandleUp" Focusable="True"
              KeyDown="HandleKey" AutomationProperties.Name="展开或收起额度详情">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
          <TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="15"/>
          <TextBlock x:Name="Percent" Grid.Column="1" Text="登录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Countdown" Grid.Column="2" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
          <TextBlock x:Name="Chevron" Grid.Column="3" Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Border>
      <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" MaxHeight="650">
        <StackPanel Margin="16,5,16,14">
          <Grid Margin="0,2,0,12">
            <TextBlock Text="CODEX 额度监控" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="PlanLabel" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
          </Grid>
          <TextBlock x:Name="AccountLabel" Text="随时掌握剩余额度。" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
          <StackPanel x:Name="LimitCards"/>
          <TextBlock x:Name="CreditsLabel" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock x:Name="StatusLabel" Text="使用 ChatGPT 账户安全登录。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
          <StackPanel x:Name="LoginPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="请在浏览器中输入此代码：" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="DeviceCodeText" IsReadOnly="True" FontSize="22" FontWeight="SemiBold" HorizontalContentAlignment="Center" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="10" Margin="0,8" AutomationProperties.Name="ChatGPT 设备验证码"/>
            <WrapPanel><Button Content="复制代码" Click="CopyCode"/><Button Content="打开浏览器" Click="OpenLoginBrowser"/><Button Content="取消" Click="CancelLogin"/></WrapPanel>
            <TextBlock Text="如有提示，请在 ChatGPT 设置 → 安全中启用设备代码授权。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
          </StackPanel>
          <WrapPanel>
            <Button x:Name="SignInButton" Content="使用 ChatGPT 登录" Click="SignIn"/>
            <Button x:Name="RefreshButton" Content="刷新" Click="RefreshClick" Visibility="Collapsed"/>
            <Button x:Name="ResetButton" Content="使用重置次数" Click="ResetClick" Visibility="Collapsed"/>
          </WrapPanel>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8,0,10"/>
          <CheckBox x:Name="PinnedCheck" Content="窗口置顶" Click="PinChanged"/>
          <CheckBox x:Name="NotifyCheck" Content="额度变化时通知（±1%）" Click="NotifyChanged"/>
          <CheckBox x:Name="StartupCheck" Content="开机自动启动" Click="StartupChanged"/>
          <WrapPanel VerticalAlignment="Center" Margin="0,6,0,0">
            <TextBlock Text="自动刷新间隔" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="IntervalBox" Width="72" AutomationProperties.Name="自动刷新间隔" SelectionChanged="IntervalChanged">
              <ComboBoxItem Content="5 分钟" Tag="5"/><ComboBoxItem Content="10 分钟" Tag="10"/><ComboBoxItem Content="15 分钟" Tag="15"/>
              <ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="60 分钟" Tag="60"/>
            </ComboBox>
            <TextBlock Text="解锁、重连时也刷新" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
          </WrapPanel>
          <TextBlock Text="Windows 解锁或网络恢复连接时也会自动刷新。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,12"/>
          <WrapPanel><Button Content="隐藏到托盘" Click="HideClick"/><Button x:Name="SignOutButton" Content="退出登录" Click="SignOut" Visibility="Collapsed"/><Button Content="退出" Click="ExitClick"/></WrapPanel>
          <TextBlock Text="非官方工具 · v0.1.3 中文版" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
        </StackPanel>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
